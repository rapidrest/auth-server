{
  "name": "auth-server",
  "version": "0.1.0",
  "description": "A reference implementation of a RapidREST authorization server using @rapidrest/auth.",
  "type": "module",
  "repository": "github/auth-server",
  "author": "Jean-Philippe Steinmetz <rapidrests@gmail.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && tsc -p tsconfig.client.json && vite build",
    "debug": "rapidrest dev --inspect",
    "dev": "rapidrest dev",
    "docs": "typedoc --plugin typedoc-plugin-markdown --out docs/reference --target esnext --mode file src",
    "lint": "eslint ./apps ./src ./test",
    "local-audit": "yarn install && yarn npm audit -A -R \"$@\"",
    "checkup": "yarn dlx @yarnpkg/doctor \"$@\"",
    "dependency-check": "yarn dlx depcheck \"$@\"",
    "report-coverage": "cat ./coverage/lcov.info | coveralls",
    "profile:process": "node --prof-process --call-graph",
    "profile:view": "npx speedscope",
    "start": "rapidrest start",
    "test": "vitest run --coverage",
    "test:prod": "yarn lint && yarn test",
    "test:watch": "vitest --coverage",
    "version": "node scripts/update_helm_version.js && git add helm/* README.md single_node_install.sh",
    "postversion": "git push --follow-tags"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "es5"
  },
  "dependencies": {
    "@rapidrest/auth": "^1.0.0-beta.1",
    "@rapidrest/core": "^1.9.0",
    "@rapidrest/react": "^0.8.0",
    "@rapidrest/service-core": "^1.0.0-rc.25",
    "@simplewebauthn/server": "^13.3.2",
    "@types/node": "^25.9.3",
    "argon2": "^0.45.0",
    "axios": "^1.17.0",
    "jwks-rsa": "^4.1.0",
    "lodash-es": "^4.18.1",
    "mongodb": "^7.5.0",
    "nconf": "^0.13.0",
    "openapi3-ts": "^4.6.0",
    "otplib": "^13.4.1",
    "prom-client": "^15.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@rapidrest/cli": "^0.4.0",
    "@swc/core": "^1.15.41",
    "@types/ioredis-mock": "^8",
    "@types/nconf": "^0.10.7",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "coveralls": "^3.1.1",
    "eslint": "^10.5.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.0.2",
    "globals": "^17.6.0",
    "ioredis": "^5.11.1",
    "ioredis-mock": "^8.13.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "sqlite3": "^6.0.1",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "uuid": "^14.0.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.8"
  },
  "resolutions": {
    "semver": "^7.5.2",
    "axios": "^1.17.0",
    "json-schema": "^0.4.0"
  },
  "packageManager": "yarn@4.2.2",
  "engines": {
    "node": ">=24.0.0"
  }
}
