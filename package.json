    "mongodb": "^7.8.0",
    "nconf": "^0.13.0",
    "nodemailer": "^10.3.1",
    "openapi3-ts": "^4.6.2",
    "otplib": "^13.6.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "twilio": "^6.2.0",
    "typeorm": "^1.1.2",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@rapidrest/cli": "^2.1.0",
    "@swc/core": "^1.16.21",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nconf": "^0.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "better-sqlite3": "^12.11.1",
    "coveralls": "^3.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.4.3",
    "globals": "^17.14.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.4",
    "semver": "^7.8.6",
    "sqlite3": "^6.0.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
