    "@rapidrest/service-core": "^2.5.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@types/node": "^26.6.6",
    "argon2": "^0.45.2",
    "axios": "^1.21.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
