{
  "name": "auth-server",
  "version": "0.1.0",
  "description": "A reference implementation of a RapidREST authorization server using @rapidrest/auth.",
  "type": "module",
  "repository": "github/auth-server",
  "author": "Jean-Philippe Steinmetz <rapidrests@gmail.com>",
  "license": "MPL-2.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rapidrest build",
    "debug": "rapidrest dev --inspect",
    "dev": "rapidrest dev",
    "lint": "eslint ./apps ./src ./test",
    "local-audit": "yarn install && yarn npm audit -A -R \"$@\"",
    "checkup": "yarn dlx @yarnpkg/doctor \"$@\"",
    "dependency-check": "yarn dlx depcheck \"$@\"",
    "report-coverage": "cat ./coverage/lcov.info | coveralls",
    "profile:process": "node --prof-process --call-graph",
    "profile:view": "npx speedscope",
    "start": "rapidrest start",
    "test": "rapidrest test --coverage",
    "test:watch": "rapidrest --watch --coverage",
    "release": "rapidrest release"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "es5"
  },
  "dependencies": {
    "@rapidrest/auth": "^1.2.0",
    "@rapidrest/core": "^5.1.0",
    "@rapidrest/react": "^1.0.1",
    "@rapidrest/service-core": "^1.3.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/node": "^26.2.0",
    "argon2": "^0.45.1",
    "axios": "^1.19.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "lodash-es": "^4.18.1",
    "mongodb": "^7.5.0",
    "nconf": "^0.13.0",
    "openapi3-ts": "^4.6.1",
    "otplib": "^13.5.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@rapidrest/cli": "^0.19.0",
    "@swc/core": "^1.16.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nconf": "^0.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "better-sqlite3": "^12.9.0",
    "coveralls": "^3.1.1",
    "eslint": "^10.9.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.2.1",
    "globals": "^17.11.0",
    "js-yaml": "^5.4.1",
    "jsdom": "^30.0.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "semver": "^7.8.5",
    "sqlite3": "^6.0.1",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.11",
    "uuid": "^14.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "semver": "^7.5.2",
    "axios": "^1.19.0",
    "json-schema": "^0.4.0"
  },
  "packageManager": "yarn@4.2.2",
  "engines": {
    "node": ">=24.0.0"
  }
}
